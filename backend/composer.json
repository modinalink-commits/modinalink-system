{
  "name": "modinalink/backend",
  "type": "project",
  "description": "ModinaLink IT Solution API (Laravel 12)",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "^2.10"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": { "App\\": "app/", "Database\\Seeders\\": "database/seeders/" }
  },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": {
    "post-autoload-dump": [ "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi" ]
  },
  "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true },
  "minimum-stability": "stable",
  "prefer-stable": true
}
