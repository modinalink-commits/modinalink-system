APP_NAME="ModinaLink"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://modinalink.com
APP_TIMEZONE=Asia/Dhaka
FRONTEND_URL=https://modinalink.com
CORS_ALLOWED_ORIGINS=https://modinalink.com,https://www.modinalink.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=modinalink
DB_USERNAME=modinalink
DB_PASSWORD=CHANGE_ME

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# First admin account created by `php artisan db:seed`
ADMIN_NAME="Mohammad Faruk"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mail (for receipts and ticket updates). Use your own SMTP.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="ModinaLink"
